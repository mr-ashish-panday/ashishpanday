# Leave empty for local development unless you want to point the frontend at a custom API host.
VITE_API_URL=

# Required for deployed contact-message persistence on Vercel.
# Vercel adds this automatically after you connect a Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# Required for deployed email notifications.
# Use Resend on Vercel so each contact submission emails you instantly.
RESEND_API_KEY=

# Verified sender address in Resend, for example:
# Portfolio Contact <hello@yourdomain.com>
CONTACT_FROM_EMAIL=

# Where contact notifications should be delivered.
# If left empty, the backend falls back to the profile email.
CONTACT_NOTIFICATION_EMAIL=

# Set to false if you do not want an automatic confirmation email sent to visitors.
CONTACT_AUTO_REPLY_ENABLED=true
